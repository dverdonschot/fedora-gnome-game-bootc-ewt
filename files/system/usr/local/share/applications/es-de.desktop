[Desktop Entry]
Type=Application
Name=ES-DE Game Frontend
GenericName=Retro game library launcher
Comment=EmulationStation Desktop Edition
# The AppImage itself is machine data (not in the image); see
# build/flatpak-list.txt for the one-time install command.
Exec=env SDL_GAMECONTROLLERCONFIG=0300cb231f08000001e4000010010000,SFC Controller,a:b2,b:b1,back:b8,dpdown:+a1,dpleft:-a0,dpright:+a0,dpup:-a1,leftshoulder:b4,rightshoulder:b5,start:b9,x:b3,y:b0,platform:Linux, /var/lib/es-de/ES-DE_x64.AppImage
Terminal=false
Icon=applications-games
Categories=Game;Emulator;
Keywords=games;retro;emulation;
