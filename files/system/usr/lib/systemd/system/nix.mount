# /nix sits inside the read-only ostree deployment, so nix has no writable
# store until a persistent directory is bound over it. /var is the
# persistent mount on bootc/ostree, so /var/nix becomes the store.
#
# Order matters for Fedora's nix units:
#   - nix-daemon.service carries ConditionPathIsReadWrite=/nix/var/nix/
#     daemon-socket — it silently skips (condition unmet) if it starts
#     before /nix is writable. This unit is Before both nix units for
#     that reason.
#   - The daemon-socket directory itself is created by
#     usr/lib/tmpfiles.d/nix-daemon-socket.conf in this tree.
#
# NO After/Requires=local-fs.target here: systemd pulls every mount whose
# Where= is a system path into local-fs.target on its own, so those lines
# create an ordering cycle (local-fs -> nix.mount -> local-fs) and systemd
# deletes the mount job at boot. Bind mounts get their source-mount
# ordering automatically from What=/var/nix.
#
# Verified live on the N100 game box (see README "Nix"): with this unit
# active, nix-store --init + nix-daemon start and `nix store ping`
# reports Store URL: daemon.

[Unit]
Description=Writable nix store (bind /var/nix over the read-only deployment /nix)
Documentation=man:nix-store(1)
Before=nix-daemon.socket nix-daemon.service

[Mount]
What=/var/nix
Where=/nix
Type=none
Options=bind

[Install]
WantedBy=multi-user.target
