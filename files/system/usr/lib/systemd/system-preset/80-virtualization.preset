# Enable libvirt services for virt-manager support
enable libvirtd.socket
enable virtnetworkd.socket
enable virtqemud.socket

# Enable nix-daemon (multi-user nix; nixbld users come from sysusers.d/nix.conf
# at boot). Fedora's 90-systemd.preset disables-by-default, so preset is a
# no-op for units not named in a preset file.
enable nix.mount
# nix-daemon.service runs standalone and binds its own socket; the
# nix-daemon.socket unit would only collide with it (Address already in
# use) — preset-enable the service, not the socket.
enable nix-daemon.service

# Enable podman socket for Docker-compatible API access
# enable podman.socket

# Tailscale was previously layered via rpm-ostree (which applies presets on
# deploy); in the image, Fedora's 90-systemd.preset disable-by-default would
# otherwise leave tailscaled down.
enable tailscaled.service
